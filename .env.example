# Copy this file to .env.local for local development.
# Never commit real passwords, tokens, or connection strings.

MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster>.mongodb.net/learning-platform?appName=Cluster0
SESSION_SECRET=replace-with-a-long-random-secret
NODE_ENV=development# Copy this file to .env for local development.
# In Vercel, set these same names under Project Settings → Environment Variables.

# MongoDB Atlas connection string (required — localhost won't work on Vercel)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/learning-platform

# Any long, random string
SESSION_SECRET=change-this-to-a-long-random-string
# Run this command in your terminal to generate a random string for SESSION_SECRET:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"


# Email verification (SMTP)
# Example: Gmail SMTP uses smtp.gmail.com, port 587, and an App Password.
APP_URL=http://localhost:9000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=