<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Edit Course — LearnHub</title><link rel="stylesheet" href="/style.css"></head><body class="app-body"><%- include('_navbar',{active:'dashboard',name,role}) %><main class="page-content"><div class="page-header"><div><h1 class="page-title">Edit Course</h1><p class="page-subtitle">Update your course content, lessons and quiz.</p></div></div><div class="white-card"><form action="/courses/<%=course._id%>/edit" method="POST" enctype="multipart/form-data" class="form-grid"><div class="field"><label>Course Title *</label><input class="form-input" name="title" required minlength="3" value="<%=course.title%>"></div><div class="field"><label>Thumbnail URL</label><input class="form-input" name="thumbnail" type="url" value="<%=course.thumbnail && !course.thumbnail.startsWith('data:') ? course.thumbnail : ''%>"></div><div class="field"><label>Upload Thumbnail</label><input class="form-input" type="file" name="thumbnailFile" accept="image/jpeg,image/png,image/webp,image/gif"><small class="muted">JPG/PNG/WEBP/GIF, max 2 MB.</small></div><div class="field"><label>Description *</label><textarea class="form-input" name="description" required minlength="10"><%=course.description%></textarea></div><div class="field-row"><div class="field"><label>Category</label><select class="form-input" name="category"><% categories.forEach(x=>{ %><option value="<%=x.name%>" <%=course.category===x.name?'selected':''%>><%=x.name%></option><% }) %></select></div><div class="field"><label>Difficulty</label><select class="form-input" name="level"><% ['Beginner','Intermediate','Advanced'].forEach(x=>{ %><option <%=course.level===x?'selected':''%>><%=x%></option><% }) %></select></div></div><div class="field"><label>Duration</label><input class="form-input" name="duration" value="<%=course.duration%>"></div><div class="field"><label>Learning Outcomes</label><textarea class="form-input" name="learningOutcomes"><%= (course.learningOutcomes||[]).join('\n') %></textarea></div><div class="field"><label>Course Curriculum</label><textarea class="form-input" name="lessons" rows="10"><%=(course.lessons||[]).map(l=>[l.title,l.description,l.duration,l.videoUrl,l.content].join(' | ')).join('\n')%></textarea><small class="muted">One lesson per line: Title | Description | Duration | Video URL | Lesson content.</small></div><div class="field"><label>Quiz Name</label><input class="form-input" name="quizName" value="<%=course.quizzes?.[0]?.name||''%>"></div><div class="field"><label>Quiz Questions</label><textarea class="form-input" name="quizQuestions" rows="8"><%=(course.quizzes?.[0]?.questions||[]).map(q=>[q.question,...q.options,q.correctAnswer].join(' | ')).join('\n')%></textarea><small class="muted">Question | A | B | C | D | Correct option number (0–3).</small></div><% if(role==='admin'){ %><div class="field"><label>Publication Status</label><select class="form-input" name="status"><% ['draft','pending','published','rejected'].forEach(x=>{ %><option value="<%=x%>" <%=course.status===x?'selected':''%>><%=x%></option><% }) %></select></div><% } %><div class="form-actions"><button class="btn btn-blue">Save Changes</button><a class="btn btn-ghost" href="/courses/<%=course._id%>">Cancel</a></div></form></div></main></body></html>
