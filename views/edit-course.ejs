<!doctype html><html><head>
    <script>(function(){try{var t=localStorage.getItem('learnhub-theme');if(!t&&window.matchMedia)t=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Edit Course — LearnHub</title><link rel="stylesheet" href="/style.css?v=3"></head><body class="app-body"><%- include('_navbar',{active:'dashboard',name,role}) %><main class="page-content"><div class="page-header"><div><h1 class="page-title">Edit Course</h1><p class="page-subtitle">Update your course content, lessons and quiz.</p></div></div><div class="white-card"><form id="courseForm" action="/courses/<%=course._id%>/edit" method="POST" enctype="multipart/form-data" class="form-grid"><div class="field"><label>Course Title *</label><input class="form-input" name="title" required minlength="3" value="<%=course.title%>"></div><div class="field"><label>Thumbnail URL</label><input class="form-input" name="thumbnail" type="url" value="<%=course.thumbnail && !course.thumbnail.startsWith('data:') ? course.thumbnail : ''%>"></div><div class="field"><label>Upload Thumbnail</label><input class="form-input" type="file" id="thumbnailFile" name="thumbnailFile" accept="image/jpeg,image/png,image/webp,image/gif"><small class="muted">JPG/PNG/WEBP/GIF, max 2 MB.</small></div><div class="field"><label>Description *</label><textarea class="form-input" name="description" required minlength="10"><%=course.description%></textarea></div><div class="field-row"><div class="field"><label>Category</label><select class="form-input" name="category"><% categories.forEach(x=>{ %><option value="<%=x.name%>" <%=course.category===x.name?'selected':''%>><%=x.name%></option><% }) %></select></div><div class="field"><label>Difficulty</label><select class="form-input" name="level"><% ['Beginner','Intermediate','Advanced'].forEach(x=>{ %><option <%=course.level===x?'selected':''%>><%=x%></option><% }) %></select></div></div><div class="field"><label>Duration</label><input class="form-input" name="duration" value="<%=course.duration%>"></div><div class="field"><label>Learning Outcomes</label><textarea class="form-input" name="learningOutcomes"><%= (course.learningOutcomes||[]).join('\n') %></textarea></div><div class="field"><label>Course Curriculum</label><textarea class="form-input" name="lessons" rows="10"><%=(course.lessons||[]).map(l=>[l.title,l.description,l.duration,l.videoUrl,l.content].join(' | ')).join('\n')%></textarea><small class="muted">One lesson per line: Title | Description | Duration | Video URL | Lesson content.</small></div><div class="field"><label>Replace / Upload Lesson Videos</label><div style="display:grid;gap:10px;"><% (course.lessons||[]).forEach((lesson,i)=>{ %><label style="font-weight:600">Lesson <%=i+1%> — <%=lesson.title%> <% if(lesson.videoUrl){ %><a href="<%=lesson.videoUrl%>" target="_blank" class="badge badge-blue" style="margin-left:8px; text-decoration:none">▶ Play Video</a><% } %><input class="direct-video-upload form-input" data-lesson-index="<%=i%>" type="file" accept="video/mp4,video/webm,video/ogg,video/quicktime"></label><% }) %></div><small class="muted">Uploading a file replaces that lesson's video URL. MP4/WebM/OGG/MOV, max 50 MB each. Existing videos stay unchanged if no new file is selected.</small></div><div class="field"><label>Quiz Name</label><input class="form-input" name="quizName" value="<%=course.quizzes?.[0]?.name||''%>"></div><div class="field"><label>Quiz Questions</label><textarea class="form-input" name="quizQuestions" rows="8"><%=(course.quizzes?.[0]?.questions||[]).map(q=>[q.question,...q.options,q.correctAnswer].join(' | ')).join('\n')%></textarea><small class="muted">Question | A | B | C | D | Correct option number (0–3).</small></div><% if(role==='admin'){ %><div class="field"><label>Publication Status</label><select class="form-input" name="status"><% ['draft','pending','published','rejected'].forEach(x=>{ %><option value="<%=x%>" <%=course.status===x?'selected':''%>><%=x%></option><% }) %></select></div><% } %><div class="form-actions"><button type="submit" class="btn btn-blue">Save Changes</button><a class="btn btn-ghost" href="/courses/<%=course._id%>">Cancel</a></div></form></div></main><script>
(function(){
  const cfg=<%- JSON.stringify(typeof cloudinaryUpload !== 'undefined' ? cloudinaryUpload : { enabled:false }) %>;
  const form=document.getElementById('courseForm'); if(!form)return;
  const submit=form.querySelector('button[type="submit"]'); const status=document.createElement('div'); status.className='muted'; submit.parentNode.insertBefore(status,submit);
  function addHidden(name,value){let x=form.querySelector('input[name="'+name+'"]');if(!x){x=document.createElement('input');x.type='hidden';x.name=name;form.appendChild(x);}x.value=value;}
  async function upload(file,type){
    if(!cfg.enabled)throw new Error('Cloudinary is not configured. Add CLOUDINARY_CLOUD_NAME and CLOUDINARY_API_KEY in Vercel.');
    if(cfg.useProxy&&type==='image'){const d=new FormData();d.append('file',file);const r=await fetch('/api/cloud-upload',{method:'POST',body:d});const o=await r.json();if(!r.ok)throw new Error(o.error||'Thumbnail upload failed.');return o.secure_url;}
    if(!cfg.uploadPreset)throw new Error('Set CLOUDINARY_UPLOAD_PRESET in Vercel for video uploads (create an unsigned preset in the Cloudinary dashboard).');
    const d=new FormData();d.append('file',file);d.append('upload_preset',cfg.uploadPreset);d.append('folder',type==='video'?'learnhub/course-videos':'learnhub/course-thumbnails');
    const r=await fetch('https://api.cloudinary.com/v1_1/'+encodeURIComponent(cfg.cloudName)+'/'+type+'/upload',{method:'POST',body:d});const o=await r.json();
    if(!r.ok)throw new Error(o.error?.message||'Video upload failed.');
    return o.secure_url;
  }
  form.addEventListener('submit',async e=>{const thumb=document.getElementById('thumbnailFile');const vids=[...form.querySelectorAll('.direct-video-upload')].filter(x=>x.files&&x.files[0]);if(!thumb?.files?.[0]&&!vids.length)return;if(!cfg.enabled&&!vids.length)return;e.preventDefault();if(submit.disabled)return;try{submit.disabled=true;if(thumb?.files?.[0]){status.textContent='Uploading thumbnail...';addHidden('thumbnail',await upload(thumb.files[0],'image'));thumb.name='';}for(let n=0;n<vids.length;n++){const v=vids[n];status.textContent='Uploading lesson video '+(n+1)+' of '+vids.length+'...';addHidden('uploadedVideoUrl'+v.dataset.lessonIndex,await upload(v.files[0],'video'));}status.textContent='Saving changes...';form.submit();}catch(err){submit.disabled=false;status.textContent='Upload failed: '+err.message;alert('Upload failed: '+err.message);}});
})();
</script></body></html>
