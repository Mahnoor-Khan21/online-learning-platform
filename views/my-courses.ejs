<!DOCTYPE html><html lang="en"><head>
    <script>(function(){try{var t=localStorage.getItem('learnhub-theme');if(!t&&window.matchMedia)t=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My Courses — LearnHub</title><link rel="stylesheet" href="/style.css?v=3"></head><body class="app-body"><%- include('_navbar',{active:'courses',name,role}) %><main class="page-content"><div class="page-header"><div><h1 class="page-title">My Courses</h1><p class="page-subtitle">Your enrolled learning journey</p></div><a href="/courses" class="btn btn-ghost">← Browse Courses</a></div><% if(!courses.length){ %><div class="white-card empty-state"><div>🎯</div><h2>Nothing here yet</h2><p>Enroll in a course to start learning.</p><a href="/courses" class="btn btn-blue">Explore Courses</a></div><% } else { %><div class="course-grid"><% courses.forEach(c=>{ %><article class="course-card"><a href="/courses/<%=c._id%>" class="course-thumb" style="display:block"><% if(c.thumbnail){ %><img src="<%=c.thumbnail%>" alt="<%=c.title%>"><% } else { %><span>🎓</span><% } %></a><div class="course-card-body"><span class="course-tag"><%=c.category%></span><h3><a href="/courses/<%=c._id%>" style="color:inherit; text-decoration:none"><%=c.title%></a></h3><div class="course-instructor">👩‍🏫 <%=c.teacherName%></div><div class="progress-wrap"><div><span><%=c.lessonCount%> lessons</span><strong><%=c.progressPercent%>%</strong></div><div class="progress-bar"><i style="width:<%=c.progressPercent%>%"></i></div></div><span class="badge <%=c.isCompleted?'badge-success':'badge-blue'%>"><%=c.isCompleted?'✓ Completed':'In Progress'%></span></div><div class="course-card-actions" style="display:flex; gap:8px"><a href="/courses/<%=c._id%>" class="btn btn-ghost btn-sm" style="flex:1; text-align:center">👁 View Details</a><a href="/courses/<%=c._id%>/learn" class="btn btn-blue btn-sm" style="flex:1; text-align:center">▶ Watch Video</a></div></article><% }) %></div><% } %></main></body></html>
