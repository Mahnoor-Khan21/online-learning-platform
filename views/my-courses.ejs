<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My Courses — LearnHub</title><link rel="stylesheet" href="/style.css"></head><body class="app-body"><%- include('_navbar',{active:'courses',name,role}) %><main class="page-content"><div class="page-header"><div><h1 class="page-title">My Courses</h1><p class="page-subtitle">Your enrolled learning journey</p></div><a href="/courses" class="btn btn-ghost">← Browse Courses</a></div><% if(!courses.length){ %><div class="white-card empty-state"><div>🎯</div><h2>Nothing here yet</h2><p>Enroll in a course to start learning.</p><a href="/courses" class="btn btn-blue">Explore Courses</a></div><% } else { %><div class="course-grid"><% courses.forEach(c=>{ %><article class="course-card"><div class="course-thumb"><% if(c.thumbnail){ %><img src="<%=c.thumbnail%>" alt="<%=c.title%>"><% } else { %><span>🎓</span><% } %></div><div class="course-card-body"><span class="course-tag"><%=c.category%></span><h3><%=c.title%></h3><div class="course-instructor">👩‍🏫 <%=c.teacherName%></div><div class="progress-wrap"><div><span><%=c.lessonCount%> lessons</span><strong><%=c.progressPercent%>%</strong></div><div class="progress-bar"><i style="width:<%=c.progressPercent%>%"></i></div></div><span class="badge <%=c.isCompleted?'badge-success':'badge-blue'%>"><%=c.isCompleted?'✓ Completed':'In Progress'%></span></div><div class="course-card-actions"><a href="/courses/<%=c._id%>/learn" class="btn btn-blue btn-full"><%=c.isCompleted?'Review Course':'Continue Learning'%> →</a></div></article><% }) %></div><% } %></main></body></html>
