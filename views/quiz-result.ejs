<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quiz Result — LearnHub</title><link rel="stylesheet" href="/style.css"></head><body class="app-body"><%- include('_navbar',{active:'courses',name,role}) %><main class="page-content quiz-page"><div class="quiz-result white-card"><div class="result-icon"><%=result.passed?'🎉':'📚'%></div><h1>Quiz Completed <%=result.passed?'🎉':''%></h1><p class="result-status <%=result.passed?'passed':'failed'%>"><%=result.passed?'PASSED':'FAILED'%></p><div class="result-score"><strong><%=result.score%> / <%=result.totalQuestions%></strong><span>Score</span></div><div class="result-grid"><div><strong><%=result.totalQuestions%></strong><span>Total Questions</span></div><div><strong><%=result.correctAnswers%></strong><span>Correct Answers</span></div><div><strong><%=result.wrongAnswers%></strong><span>Wrong Answers</span></div><div><strong><%=result.percentage%>%</strong><span>Percentage</span></div></div><% if(certificate){ %><div class="certificate-unlocked"><div>🏆</div><strong>Certificate Unlocked!</strong><span>You completed the required lessons and passed the quiz.</span><a class="btn btn-green" href="/courses/<%=course._id%>/certificate">View Certificate</a></div><% } %><div class="quiz-result-actions"><a class="btn btn-blue" href="/courses/<%=course._id%>/quiz">Retake Quiz</a><a class="btn btn-ghost" href="/quiz-history">Quiz History</a><a class="btn btn-ghost" href="/courses/<%=course._id%>/learn">Back to Course</a></div></div></main></body></html>