<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password — LearnHub</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="auth-body">
    <div class="auth-card">
        <h2>Forgot Password</h2>
        <p>Enter your registered email and we will send you a password reset link.</p>

        <% if (typeof error !== 'undefined') { %>
            <div class="error-msg"><%= error %></div>
        <% } %>

        <% if (typeof success !== 'undefined') { %>
            <div class="success-msg"><%= success %></div>
        <% } %>

        <form action="/forgot-password" method="POST">
            <div class="form-group">
                <label for="email">Email:</label>
                <input class="auth-input" type="email" id="email" name="email" placeholder="Enter your email" required autocomplete="email">
            </div>
            <button type="submit" class="btn-primary">Send Reset Link</button>
        </form>

        <div class="bottom-link">Remember your password? <a href="/login">Login</a></div>
    </div>
</body>
</html>
