<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quiz Activity — LearnHub</title><link rel="stylesheet" href="/style.css"></head><body class="app-body"><%-include('_navbar',{active:'admin',name,role})%><main class="page-content"><div class="page-header"><div><h1 class="page-title">Quiz Activity</h1><p class="page-subtitle">Recent quiz attempts across the platform.</p></div></div><div class="white-card"><div class="table-wrapper"><table class="data-table"><thead><tr><th>Student</th><th>Course</th><th>Quiz</th><th>Score</th><th>Date</th></tr></thead><tbody><%attempts.forEach(a=>{%><tr><td><%=a.userName%></td><td><%=a.courseName%></td><td><%=a.quizName%></td><td><strong><%=a.percentage%>%</strong> <span class="badge badge-<%=a.passed?'blue':'red'%>"><%=a.passed?'Passed':'Failed'%></span></td><td><%=new Date(a.attemptedAt).toLocaleString()%></td></tr><%})%></tbody></table></div></div></main></body></html>
