<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LearnHub — Online Learning Platform</title>
    <link rel="stylesheet" href="style.css">
</head>
<body class="landing-body">

    <!-- Top navigation -->
    <nav class="landing-nav">
        <a href="/" class="landing-logo">Learn<span>Hub</span></a>
        <div class="landing-nav-links">
            <a href="/login"  class="nav-btn nav-btn-outline">Login</a>
            <a href="/signup" class="nav-btn nav-btn-fill">Get Started</a>
        </div>
    </nav>

    <!-- Hero section -->
    <section class="hero">
        <h1>Learn Anything,<br><span>Teach Everything</span></h1>
        <p>A simple online learning platform where students enroll in courses, teachers share knowledge, and admins keep everything running smoothly.</p>
        <div class="hero-buttons">
            <a href="/signup" class="hero-btn hero-btn-blue">Start Learning Free</a>
            <a href="/login"  class="hero-btn hero-btn-ghost">Already have an account?</a>
        </div>
    </section>

    <!-- Feature cards -->
    <div class="features">

        <div class="feature-card">
            <div class="feature-icon">🎓</div>
            <h3>For Students</h3>
            <p>Browse courses, enroll with one click, and track your learning progress all in one place.</p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">📚</div>
            <h3>For Teachers</h3>
            <p>Create and manage your courses easily. Reach students who are eager to learn from you.</p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">🛡️</div>
            <h3>For Admins</h3>
            <p>Manage users, oversee all courses, and keep the platform running smoothly.</p>
        </div>

    </div>

</body>
</html>
