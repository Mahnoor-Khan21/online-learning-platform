<!DOCTYPE html>
<html lang="en">
<head>
    <script>(function(){try{var t=localStorage.getItem('learnhub-theme');if(!t&&window.matchMedia)t=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LearnHub — Online Learning Platform</title>
    <meta name="description" content="LearnHub is a simple and powerful online learning platform for video courses, quizzes, and certificates.">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="landing-body">

    <!-- Top Navbar -->
    <header class="landing-header">
        <div class="landing-header-container">
            <a href="/" class="landing-logo">
                <span class="logo-icon">🎓</span> Learn<span class="logo-accent">Hub</span>
            </a>
            
            <nav class="landing-nav-menu">
                <a href="/courses">Courses</a>
                <a href="#categories">Categories</a>
                <a href="#features">Features</a>
                <a href="#instructors">Teach</a>
                <a href="#faq">FAQ</a>
            </nav>

            <div class="landing-header-actions">
                <button type="button" id="themeToggle" class="theme-toggle" aria-label="Toggle Theme">
                    <span class="theme-toggle-icon">🌙</span>
                    <span class="theme-toggle-text">Dark Mode</span>
                </button>

                <% if (typeof userId !== 'undefined' && userId) { %>
                    <a href="/dashboard" class="nav-btn nav-btn-outline">Dashboard</a>
                    <a href="/my-courses" class="nav-btn nav-btn-fill">My Courses →</a>
                <% } else { %>
                    <a href="/login" class="nav-btn nav-btn-outline">Log In</a>
                    <a href="/signup" class="nav-btn nav-btn-fill">Join for Free</a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- Simple Clean Hero Section -->
    <section class="landing-hero-section">
        <div class="landing-hero-container">
            <div class="landing-hero-content">
                <div class="hero-badge">
                    <span class="badge-sparkle">✨</span> Interactive Online Learning
                </div>
                <h1>Learn Anything, <span>Master Any Skill</span></h1>
                <p>Access high-quality video courses, test your knowledge with interactive quizzes, and earn shareable certificates.</p>
                
                <!-- Search Bar -->
                <form action="/courses" method="GET" class="hero-search-box">
                    <span class="search-box-icon">🔍</span>
                    <input type="text" name="search" placeholder="Search courses (e.g. Web Dev, Python, Design...)" required>
                    <button type="submit" class="hero-search-btn">Search</button>
                </form>

                <div class="hero-category-chips">
                    <span>Popular:</span>
                    <a href="/courses?category=Web+Development">Web Dev</a>
                    <a href="/courses?category=Programming">Programming</a>
                    <a href="/courses?category=Data+Science">Data Science</a>
                </div>
            </div>

            <!-- Realistic Photo Showcase -->
            <div class="landing-hero-visual">
                <div class="hero-image-wrapper">
                    <img src="/images/hero-banner.png" alt="Student studying online" class="hero-main-img">
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Bar -->
    <section class="landing-stats-bar">
        <div class="stats-bar-container">
            <div class="stat-box">
                <span class="stat-number"><%= totalCourses %>+</span>
                <span class="stat-title">Courses Available</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-box">
                <span class="stat-number"><%= totalStudents %>+</span>
                <span class="stat-title">Enrolled Students</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-box">
                <span class="stat-number"><%= totalTeachers %>+</span>
                <span class="stat-title">Expert Instructors</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-box">
                <span class="stat-number">100%</span>
                <span class="stat-title">Verified Certificates</span>
            </div>
        </div>
    </section>

    <!-- Featured Courses Section -->
    <section class="landing-courses-section">
        <div class="landing-section-header">
            <div>
                <span class="section-eyebrow">EXPLORE CATALOG</span>
                <h2>Featured Courses</h2>
                <p>Explore top rated courses taught by verified instructors.</p>
            </div>
            <a href="/courses" class="btn btn-outline-light">View All Courses →</a>
        </div>

        <div class="landing-course-grid">
            <% if (featuredCourses && featuredCourses.length) { %>
                <% featuredCourses.forEach(c => { %>
                    <div class="landing-course-card">
                        <div class="course-card-image">
                            <% if (c.thumbnail) { %>
                                <img src="<%= c.thumbnail %>" alt="<%= c.title %>">
                            <% } else { %>
                                <div class="course-card-placeholder">🎓</div>
                            <% } %>
                            <span class="course-card-category"><%= c.category %></span>
                        </div>
                        <div class="course-card-content">
                            <h3><a href="/courses/<%= c._id %>"><%= c.title %></a></h3>
                            <p><%= c.description %></p>
                            
                            <div class="course-card-meta">
                                <span>📖 <%= (c.lessons || []).length %> Lessons</span>
                                <span>⭐ <%= Number(c.rating || 0).toFixed(1) %></span>
                            </div>

                            <div class="course-card-footer">
                                <div class="course-instructor">
                                    <span>👤 <%= c.teacherName %></span>
                                </div>
                                <a href="/courses/<%= c._id %>" class="btn btn-sm btn-blue">View Course</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="landing-empty-courses">
                    <span>📚</span>
                    <h3>Courses Available Soon</h3>
                    <p>Instructors are currently publishing courses.</p>
                    <a href="/courses" class="btn btn-blue">Browse Catalog</a>
                </div>
            <% } %>
        </div>
    </section>

    <!-- Categories Grid -->
    <section id="categories" class="landing-categories-section">
        <div class="landing-section-header center">
            <span class="section-eyebrow">POPULAR SUBJECTS</span>
            <h2>Course Categories</h2>
            <p>Select a topic to start learning today</p>
        </div>

        <div class="landing-category-grid">
            <a href="/courses?category=Web+Development" class="category-card">
                <span class="cat-icon">💻</span>
                <h3>Web Development</h3>
                <p>HTML, CSS, JavaScript, React & Backend</p>
            </a>
            <a href="/courses?category=Programming" class="category-card">
                <span class="cat-icon">⚡</span>
                <h3>Programming</h3>
                <p>Python, C++, Java & Computer Science</p>
            </a>
            <a href="/courses?category=Data+Science" class="category-card">
                <span class="cat-icon">📊</span>
                <h3>Data Science</h3>
                <p>Machine Learning, SQL & Data Analytics</p>
            </a>
            <a href="/courses?category=Design" class="category-card">
                <span class="cat-icon">🎨</span>
                <h3>UI/UX Design</h3>
                <p>Figma, Prototyping & Visual Design</p>
            </a>
        </div>
    </section>

    <!-- Instructor Banner -->
    <section id="instructors" class="landing-instructor-banner">
        <div class="instructor-banner-container">
            <div class="instructor-banner-visual">
                <img src="/images/instructor-feature.png" alt="Instructor teaching on LearnHub">
            </div>
            <div class="instructor-banner-content">
                <span class="section-eyebrow">FOR TEACHERS</span>
                <h2>Teach & Share Knowledge on LearnHub</h2>
                <p>Create your course, upload video lessons via Cloudinary, add quizzes, and guide students toward completion.</p>
                <div class="instructor-cta-buttons">
                    <a href="/signup" class="btn btn-blue btn-lg">Start Teaching Today →</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Simple FAQ Accordion -->
    <section id="faq" class="landing-faq-section">
        <div class="landing-section-header center">
            <span class="section-eyebrow">QUESTIONS</span>
            <h2>Frequently Asked Questions</h2>
        </div>

        <div class="landing-faq-container">
            <details class="faq-item" open>
                <summary class="faq-question">How do I enroll in a course?</summary>
                <div class="faq-answer">
                    Sign up for a free student account, select any course, and click "Enroll Now" to access video lessons immediately.
                </div>
            </details>

            <details class="faq-item">
                <summary class="faq-question">How do I get a certificate?</summary>
                <div class="faq-answer">
                    Complete all lessons in a course and pass the course quiz with at least 60% score to receive your certificate.
                </div>
            </details>

            <details class="faq-item">
                <summary class="faq-question">Can I create my own course?</summary>
                <div class="faq-answer">
                    Yes! Instructors can create courses, upload HD lesson videos, and build custom quizzes from the instructor studio.
                </div>
            </details>
        </div>
    </section>

    <!-- Footer -->
    <footer class="landing-footer">
        <div class="landing-footer-container">
            <div class="footer-brand">
                <a href="/" class="landing-logo">
                    <span class="logo-icon">🎓</span> Learn<span class="logo-accent">Hub</span>
                </a>
                <p>Online learning platform for video courses, quizzes, and certificates.</p>
            </div>

            <div class="footer-links-group">
                <h4>Explore</h4>
                <a href="/courses">All Courses</a>
                <a href="#categories">Categories</a>
                <a href="/signup">Sign Up</a>
            </div>

            <div class="footer-links-group">
                <h4>Instructors</h4>
                <a href="/signup">Become an Instructor</a>
                <a href="/login">Log In</a>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© 2026 LearnHub. All rights reserved.</p>
        </div>
    </footer>

    <!-- Theme Toggle & Scroll Animation Script -->
    <script>
    (function(){
      const key = 'learnhub-theme';
      const toggle = document.getElementById('themeToggle');
      const icon = toggle?.querySelector('.theme-toggle-icon');
      const label = toggle?.querySelector('.theme-toggle-text');
      
      function setTheme(theme){
        document.documentElement.setAttribute('data-theme', theme);
        try { localStorage.setItem(key, theme); } catch(e){}
        if(icon) icon.textContent = theme === 'dark' ? '☀️' : '🌙';
        if(label) label.textContent = theme === 'dark' ? 'Light Mode' : 'Dark Mode';
        if(toggle) toggle.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
      }
      
      const saved = localStorage.getItem(key);
      const preferred = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      setTheme(preferred);
      
      if(toggle) {
        toggle.addEventListener('click', function(){
          const current = document.documentElement.getAttribute('data-theme') || 'light';
          setTheme(current === 'dark' ? 'light' : 'dark');
        });
      }

      // Scroll Reveal Animations
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if(entry.isIntersecting) {
            entry.target.classList.add('reveal-active');
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      document.querySelectorAll('.landing-hero-content, .landing-hero-visual, .stat-box, .landing-course-card, .category-card, .lms-feature-card, .instructor-banner-container, .faq-item').forEach(el => {
        el.classList.add('reveal-on-scroll');
        observer.observe(el);
      });
    })();
    </script>
</body>
</html>
