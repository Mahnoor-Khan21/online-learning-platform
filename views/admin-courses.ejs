<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Manage Courses — LearnHub</title><link rel="stylesheet" href="/style.css"></head><body class="app-body"><%-include('_navbar',{active:'admin',name,role})%><main class="page-content"><div class="page-header"><div><h1 class="page-title">Manage Courses</h1><p class="page-subtitle">Approve, publish, edit or remove courses.</p></div></div><div class="white-card"><div class="table-wrapper"><table class="data-table"><thead><tr><th>Course</th><th>Instructor</th><th>Students</th><th>Rating</th><th>Status</th><th>Actions</th></tr></thead><tbody><%courses.forEach(c=>{%><tr><td><strong><%=c.title%></strong><br><small><%=c.category%> · <%=c.level%></small></td><td><%=c.teacherName%></td><td><%=c.enrolledStudents?.length||0%></td><td>⭐ <%=Number(c.rating||0).toFixed(1)%> (<%=c.reviews?.length||0%>)</td><td><form action="/admin/courses/<%=c._id%>/status" method="POST"><select class="form-input" name="status" onchange="this.form.submit()"><%['draft','pending','published','rejected'].forEach(x=>{%><option value="<%=x%>" <%=c.status===x?'selected':''%>><%=x%></option><%})%></select></form></td><td><div class="table-actions"><a class="btn btn-ghost btn-sm" href="/courses/<%=c._id%>">View</a><a class="btn btn-blue btn-sm" href="/courses/<%=c._id%>/edit">Edit</a><form action="/courses/<%=c._id%>/delete" method="POST" onsubmit="return confirm('Delete this course?')"><button class="btn btn-red btn-sm">Delete</button></form></div></td></tr><%})%></tbody></table></div></div></main></body></html>
