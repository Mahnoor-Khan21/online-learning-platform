<!-- LearnHub LMS sidebar + topbar -->
<aside class="app-sidebar">
  <a href="/dashboard" class="sidebar-brand"><span class="brand-mark">L</span><span>Learn<span>Hub</span></span></a>
  <div class="sidebar-role"><span class="role-dot"></span><%= role === 'teacher' ? 'Instructor Portal' : role === 'admin' ? 'Admin Portal' : 'Student Portal' %></div>
  <nav class="sidebar-nav">
    <div class="sidebar-label">MAIN</div>
    <a href="/dashboard" class="sidebar-link <%= active === 'dashboard' ? 'active' : '' %>"><span>⌂</span>Dashboard</a>
    <a href="/courses" class="sidebar-link <%= active === 'courses' ? 'active' : '' %>"><span>▦</span>Courses</a>
    <% if (role === 'student') { %>
      <a href="/my-courses" class="sidebar-link <%= active === 'my-courses' ? 'active' : '' %>"><span>▣</span>My Learning</a>
      <a href="/calendar" class="sidebar-link"><span>□</span>Calendar</a>
      <a href="/analytics" class="sidebar-link"><span>◒</span>Performance</a>
      <a href="/my-learning-tools" class="sidebar-link"><span>☆</span>My Tools</a>
      <a href="/quiz-history" class="sidebar-link"><span>✓</span>Quiz History</a>
    <% } else if (role === 'teacher') { %>
      <a href="/courses/add" class="sidebar-link"><span>＋</span>Create Course</a>
      <a href="/instructor/students" class="sidebar-link"><span>♙</span>Students</a>
      <a href="/calendar" class="sidebar-link"><span>□</span>Live Classes</a>
      <a href="/analytics" class="sidebar-link"><span>◒</span>Analytics</a>
    <% } else { %>
      <a href="/admin/users" class="sidebar-link"><span>♙</span>Users</a>
      <a href="/admin/courses" class="sidebar-link"><span>▦</span>Course Management</a>
      <a href="/admin/enrollments" class="sidebar-link"><span>🎓</span>Enrollments</a>
      <a href="/admin/attendance" class="sidebar-link"><span>✓</span>Attendance</a>
      <a href="/admin/reports" class="sidebar-link"><span>⚑</span>Reports</a>
      <a href="/analytics" class="sidebar-link"><span>◒</span>Analytics</a>
    <% } %>
    <div class="sidebar-label">COMMUNITY</div>
    <a href="/messages" class="sidebar-link"><span>◌</span>Messages</a>
    <a href="/notifications" class="sidebar-link"><span>♢</span>Notifications</a>
    <a href="/profile" class="sidebar-link <%= active === 'profile' ? 'active' : '' %>"><span>◯</span>Profile</a>
    <% if (role === 'admin') { %><div class="sidebar-label">ADMIN</div><a href="/admin/categories" class="sidebar-link"><span>⌗</span>Categories</a><a href="/admin/quizzes" class="sidebar-link"><span>?</span>Quiz Management</a><a href="/admin/reviews" class="sidebar-link"><span>★</span>Reviews</a><% } %>
  </nav>
  <div class="sidebar-bottom"><a href="/logout-confirm" class="sidebar-logout"><span>↪</span>Sign out</a></div>
</aside>

<nav class="navbar">
  <div class="mobile-brand"><a href="/dashboard" class="navbar-logo">Learn<span>Hub</span></a></div>
  <div class="topbar-title"><span class="topbar-kicker">LEARNHUB</span><strong><%= role === 'teacher' ? 'Instructor Workspace' : role === 'admin' ? 'Administration' : 'Learning Workspace' %></strong></div>
  <div class="navbar-right">
    <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode"><span class="theme-icon">☾</span><span class="theme-label">Dark</span></button>
    <div class="topbar-search"><span>⌕</span><input aria-label="Search" placeholder="Search courses, lessons..." onkeydown="if(event.key==='Enter'){location.href='/courses?search='+encodeURIComponent(this.value)}"></div>
    <div class="notification-menu" id="notificationMenu">
      <button class="notification-bell" type="button" aria-label="Notifications" aria-expanded="false" onclick="toggleNotifications()">♢<% if (notificationUnreadCount > 0) { %><span class="notification-badge"><%= notificationUnreadCount > 99 ? '99+' : notificationUnreadCount %></span><% } %></button>
      <div class="notification-dropdown" id="notificationDropdown">
        <div class="notification-dropdown-head"><strong>Notifications</strong><a href="/notifications">View all</a></div>
        <% if (!notificationItems.length) { %><div class="notification-dropdown-empty">♢<span>No notifications yet</span></div><% } %>
        <% notificationItems.forEach(n => { const icon = ({course:'▦',enrollment:'🎓',quiz:'✓',completion:'🏆',certificate:'▤',announcement:'⚑',system:'♢'})[n.type] || '♢'; %>
          <div class="notification-item <%= n.readAt ? 'is-read' : 'is-unread' %>"><div class="notification-icon notification-type-<%= n.type %>"><%= icon %></div><div class="notification-item-content"><a href="<%= n.link || '/notifications' %>" onclick="markNotificationRead('<%= n._id %>')"><strong><%= n.title %></strong><span><%= n.message %></span><small><%= new Date(n.createdAt).toLocaleString() %></small></a><% if(!n.readAt){ %><button type="button" class="notification-read-btn" onclick="event.preventDefault();event.stopPropagation();markNotificationRead('<%= n._id %>')">Mark read</button><% } %></div></div>
        <% }) %>
        <div class="notification-dropdown-foot"><form action="/notifications/read-all" method="POST"><button type="submit">Mark all as read</button></form><a href="/notifications">View all notifications →</a></div>
      </div>
    </div>
    <a class="topbar-user" href="/profile"><span class="topbar-avatar"><% if (typeof currentUser !== 'undefined' && currentUser && currentUser.profilePicture) { %><img src="<%= currentUser.profilePicture %>" alt="Profile picture"><% } else { %><%= (name || 'U').charAt(0).toUpperCase() %><% } %></span><span><strong><%= name %></strong><small><%= role === 'teacher' ? 'Instructor' : role === 'admin' ? 'Administrator' : 'Student' %></small></span></a>
  </div>
</nav>
<script>
function toggleNotifications(){const m=document.getElementById('notificationMenu'),d=document.getElementById('notificationDropdown');const open=m.classList.toggle('open');d.classList.toggle('open',open);m.querySelector('.notification-bell').setAttribute('aria-expanded',open?'true':'false');}
async function markNotificationRead(id){try{await fetch('/notifications/'+id+'/read',{method:'POST',headers:{Accept:'application/json'}});}catch(e){} }
document.addEventListener('click',e=>{const m=document.getElementById('notificationMenu');if(m&&!m.contains(e.target)){m.classList.remove('open');document.getElementById('notificationDropdown').classList.remove('open');}});
(function(){const key='learnhub-theme';const saved=localStorage.getItem(key);if(saved==='dark')document.documentElement.classList.add('dark');const b=document.getElementById('themeToggle');function sync(){const dark=document.documentElement.classList.contains('dark');b.querySelector('.theme-icon').textContent=dark?'☀':'☾';b.querySelector('.theme-label').textContent=dark?'Light':'Dark';b.setAttribute('aria-label',dark?'Switch to light mode':'Switch to dark mode');}sync();b.addEventListener('click',()=>{document.documentElement.classList.toggle('dark');localStorage.setItem(key,document.documentElement.classList.contains('dark')?'dark':'light');sync();});})();
</script>
