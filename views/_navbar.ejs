<!-- _navbar.ejs: Reusable top navbar partial -->
<nav class="navbar">
  <a href="/dashboard" class="navbar-logo">Learn<span>Hub</span></a>

  <div class="navbar-links">
    <a href="/dashboard" class="navbar-link <%= active === 'dashboard' ? 'active' : '' %>">Dashboard</a>
    <a href="/courses"   class="navbar-link <%= active === 'courses'   ? 'active' : '' %>">Courses</a>
    <% if (role === 'student') { %>
      <a href="/my-courses"   class="navbar-link <%= active === 'my-courses'   ? 'active' : '' %>">My Courses</a>
      <a href="/quiz-history" class="navbar-link <%= active === 'quiz-history' ? 'active' : '' %>">Quiz History</a>
    <% } %>
    <% if (role === 'teacher') { %>
      <a href="/courses/add" class="navbar-link">Create Course</a>
    <% } %>
    <% if (role === 'admin') { %>
      <a href="/admin/users" class="navbar-link <%= active === 'users' ? 'active' : '' %>">Admin</a>
    <% } %>
  </div>

  <div class="navbar-right">

    <!-- Notification Bell -->
    <div class="notification-menu" id="notificationMenu">
      <button class="notification-bell" type="button" aria-label="Notifications" aria-expanded="false" onclick="toggleNotifications()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <% if (notificationUnreadCount > 0) { %><span class="notification-badge"><%= notificationUnreadCount > 99 ? '99+' : notificationUnreadCount %></span><% } %>
      </button>
      <div class="notification-dropdown" id="notificationDropdown">
        <div class="notification-dropdown-head"><strong>Notifications</strong><a href="/notifications">View all</a></div>
        <% if (!notificationItems.length) { %><div class="notification-dropdown-empty"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg><span>No notifications yet</span></div><% } %>
        <% notificationItems.forEach(n => { const icon = ({course:'📚',enrollment:'🎓',quiz:'📝',completion:'🏆',certificate:'📜',announcement:'📢',system:'🔔'})[n.type] || '🔔'; %>
          <div class="notification-item <%= n.readAt ? 'is-read' : 'is-unread' %>"><div class="notification-icon notification-type-<%= n.type %>"><%= icon %></div><div class="notification-item-content"><a href="<%= n.link || '/notifications' %>" onclick="markNotificationRead('<%= n._id %>')"><strong><%= n.title %></strong><span><%= n.message %></span><small><%= new Date(n.createdAt).toLocaleString() %></small></a><% if(!n.readAt){ %><button type="button" class="notification-read-btn" onclick="event.preventDefault();event.stopPropagation();markNotificationRead('<%= n._id %>')">Mark read</button><% } %></div></div>
        <% }) %>
        <div class="notification-dropdown-foot"><form action="/notifications/read-all" method="POST"><button type="submit">Mark all as read</button></form><a href="/notifications">View all →</a></div>
      </div>
    </div>

    <!-- Dark/Light Mode Toggle -->
    <button id="themeToggle" class="theme-toggle" type="button" aria-label="Toggle dark or light mode" title="Toggle dark/light mode">
      <span class="theme-toggle-icon">🌙</span>
    </button>

    <!-- ── Profile Avatar Dropdown ── -->
    <%
      const _navPic = (typeof user !== 'undefined' && user && user.profilePicture)
        ? user.profilePicture
        : (typeof sessionProfilePic !== 'undefined' ? sessionProfilePic : null);
    %>
    <div class="nav-profile-menu" id="navProfileMenu">
      <button class="nav-profile-btn" type="button" aria-label="Open profile menu" aria-haspopup="true" aria-expanded="false" onclick="toggleProfileMenu(event)">
        <div class="nav-avatar">
          <% if (_navPic) { %>
            <img src="<%= _navPic %>" alt="<%= name %>" class="nav-avatar-img">
          <% } else { %>
            <span class="nav-avatar-letter"><%= name.charAt(0).toUpperCase() %></span>
          <% } %>
        </div>
        <svg class="nav-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>

      <!-- Dropdown Panel -->
      <div class="nav-profile-dropdown" id="navProfileDropdown" role="menu">

        <!-- User Info Header -->
        <div class="nav-pd-header">
          <div class="nav-pd-avatar">
            <% if (_navPic) { %>
              <img src="<%= _navPic %>" alt="<%= name %>" class="nav-avatar-img">
            <% } else { %>
              <span class="nav-avatar-letter"><%= name.charAt(0).toUpperCase() %></span>
            <% } %>
          </div>
          <div class="nav-pd-info">
            <p class="nav-pd-name"><%= name %></p>
            <% if (typeof user !== 'undefined' && user && user.email) { %>
              <p class="nav-pd-email"><%= user.email %></p>
            <% } %>
            <span class="nav-pd-badge badge-<%= role %>">
              <%= role === 'teacher' ? 'Instructor' : role === 'admin' ? 'Admin' : 'Student' %>
            </span>
          </div>
        </div>

        <!-- Divider -->
        <div class="nav-pd-divider"></div>

        <!-- Menu Items -->
        <div class="nav-pd-items">
          <a href="/profile" class="nav-pd-item" role="menuitem">
            <span class="nav-pd-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </span>
            My Profile
          </a>
          <a href="/dashboard" class="nav-pd-item" role="menuitem">
            <span class="nav-pd-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            </span>
            Dashboard
          </a>
          <a href="/courses" class="nav-pd-item" role="menuitem">
            <span class="nav-pd-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            </span>
            Browse Courses
          </a>
        </div>

        <!-- Divider -->
        <div class="nav-pd-divider"></div>

        <!-- Logout -->
        <div class="nav-pd-items">
          <a href="/logout-confirm" class="nav-pd-item nav-pd-item--danger" role="menuitem">
            <span class="nav-pd-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </span>
            Sign Out
          </a>
        </div>

      </div>
    </div>
    <!-- ── End Profile Dropdown ── -->

  </div>
</nav>

<script>
/* ── Notifications ── */
function toggleNotifications(){
  const m = document.getElementById('notificationMenu');
  const d = document.getElementById('notificationDropdown');
  const open = m.classList.toggle('open');
  d.classList.toggle('open', open);
  const bell = m.querySelector('.notification-bell');
  if(bell) bell.setAttribute('aria-expanded', open ? 'true' : 'false');
  if(open){
    // close profile menu
    const pm = document.getElementById('navProfileMenu');
    if(pm){ pm.classList.remove('open'); pm.querySelector('.nav-profile-btn')?.setAttribute('aria-expanded','false'); }
    try { fetch('/notifications/read-all', { credentials: 'same-origin', method: 'POST' }); } catch(e){}
  }
}
async function markNotificationRead(id){
  try { await fetch('/notifications/'+id+'/read',{credentials:'same-origin',method:'POST',headers:{Accept:'application/json'}}); } catch(e){}
}

/* ── Profile Menu ── */
function toggleProfileMenu(e){
  if(e) e.stopPropagation();
  const pm  = document.getElementById('navProfileMenu');
  const open = pm.classList.toggle('open');
  pm.querySelector('.nav-profile-btn')?.setAttribute('aria-expanded', open ? 'true' : 'false');
  if(open){
    // close notification menu
    const m = document.getElementById('notificationMenu');
    if(m){ m.classList.remove('open'); document.getElementById('notificationDropdown')?.classList.remove('open'); }
  }
}

/* ── Close both on outside click ── */
document.addEventListener('click', e => {
  const m = document.getElementById('notificationMenu');
  if(m && !m.contains(e.target)){
    m.classList.remove('open');
    document.getElementById('notificationDropdown')?.classList.remove('open');
  }
  const pm = document.getElementById('navProfileMenu');
  if(pm && !pm.contains(e.target)){
    pm.classList.remove('open');
    pm.querySelector('.nav-profile-btn')?.setAttribute('aria-expanded','false');
  }
});

/* ── Theme Toggle ── */
(function(){
  const key    = 'learnhub-theme';
  const toggle = document.getElementById('themeToggle');
  const icon   = toggle?.querySelector('.theme-toggle-icon');
  function setTheme(theme){
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem(key, theme);
    if(icon) icon.textContent = theme === 'dark' ? '☀️' : '🌙';
    if(toggle) toggle.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
  }
  const saved     = localStorage.getItem(key);
  const preferred = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  setTheme(preferred);
  if(toggle) toggle.addEventListener('click', () => setTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'));
})();
</script>
