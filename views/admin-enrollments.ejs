<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Enrollments — LearnHub</title><link rel="stylesheet" href="/style.css"></head><body class="app-body"><%-include('_navbar',{active:'admin',name,role})%><main class="page-content"><div class="page-header"><div><h1 class="page-title">Enrollments</h1><p class="page-subtitle">Platform-wide student enrollment and progress.</p></div></div><div class="white-card"><div class="table-wrapper"><table class="data-table"><thead><tr><th>Student</th><th>Course</th><th>Instructor</th><th>Progress</th></tr></thead><tbody><%rows.forEach(r=>{%><tr><td><%=r.student?.name||'Deleted user'%></td><td><%=r.course.title%></td><td><%=r.course.teacherName%></td><td><div class="progress-wrap"><strong><%=r.progress%>%</strong><div class="progress-bar"><i style="width:<%=r.progress%>%"></i></div></div></td></tr><%})%><%if(!rows.length){%><tr><td colspan="4" style="text-align:center">No enrollments yet.</td></tr><%}%></tbody></table></div></div></main></body></html>
