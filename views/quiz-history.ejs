<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quiz History — LearnHub</title><link rel="stylesheet" href="/style.css"></head><body class="app-body"><%- include('_navbar',{active:'dashboard',name,role}) %><main class="page-content"><div class="page-header"><div><h1 class="page-title">Quiz Attempt History</h1><p class="page-subtitle">Review your previous quiz attempts and results.</p></div></div><div class="white-card history-card"><% if(!attempts.length){ %><div class="empty-state"><div>📝</div><h2>No quiz attempts yet</h2><p>Complete a course quiz to see your history here.</p></div><% } else { %><div class="history-table-wrap"><table class="quiz-history-table"><thead><tr><th>Quiz</th><th>Course</th><th>Score</th><th>Percentage</th><th>Result</th><th>Attempt Date</th></tr></thead><tbody><% attempts.forEach(a=>{ %><tr><td><strong><%=a.quizName%></strong></td><td><%=a.courseName%></td><td><%=a.score%> / <%=a.totalQuestions%></td><td><%=a.percentage%>%</td><td><span class="history-result <%=a.passed?'passed':'failed'%>"><%=a.passed?'PASSED':'FAILED'%></span></td><td><%=new Date(a.attemptedAt).toLocaleString()%></td></tr><% }) %></tbody></table></div><% } %></div></main></body></html>