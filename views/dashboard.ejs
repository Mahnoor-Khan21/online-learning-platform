<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard — LearnHub</title><link rel="stylesheet" href="/style.css"></head><body class="app-body"><%-include('_navbar',{active:'dashboard',name,role})%><main class="page-content">
<% if(role==='admin'){ %>
<div class="dashboard-hero"><div><span class="eyebrow">ADMIN CONSOLE</span><h1>Welcome, <%=name%> 👋</h1><p>Full platform management and oversight.</p></div></div>
<div class="stats-grid"><div class="stat-card"><div class="stat-icon">🎓</div><div><div class="stat-value"><%=totalStudents%></div><div class="stat-label">Total Students</div></div></div><div class="stat-card"><div class="stat-icon">👨‍🏫</div><div><div class="stat-value"><%=totalInstructors%></div><div class="stat-label">Total Instructors</div></div></div><div class="stat-card green"><div class="stat-icon">📚</div><div><div class="stat-value"><%=totalCourses%></div><div class="stat-label">Total Courses</div></div></div><div class="stat-card orange"><div class="stat-icon">🧑‍🎓</div><div><div class="stat-value"><%=totalEnrollments%></div><div class="stat-label">Total Enrollments</div></div></div><div class="stat-card"><div class="stat-icon">🏆</div><div><div class="stat-value"><%=completedCourses%></div><div class="stat-label">Course Completions</div></div></div><div class="stat-card green"><div class="stat-icon">⭐</div><div><div class="stat-value"><%=Number(averageRating||0).toFixed(1)%></div><div class="stat-label">Average Rating</div></div></div></div>
<div class="quick-actions"><a class="btn btn-blue" href="/admin/users">👥 Users</a><a class="btn btn-ghost" href="/admin/courses">📚 Courses</a><a class="btn btn-ghost" href="/admin/categories">🏷️ Categories</a><a class="btn btn-ghost" href="/admin/enrollments">🎓 Enrollments</a><a class="btn btn-ghost" href="/admin/quizzes">📝 Quiz Activity</a><a class="btn btn-ghost" href="/admin/reviews">⭐ Reviews</a><a class="btn btn-ghost" href="/admin/notifications">🔔 Notifications</a><a class="btn btn-green" href="/courses/add">➕ Create Course</a></div>
<div class="dashboard-two-col"><section class="white-card"><h2>📢 Announcement</h2><form action="/admin/announcements" method="POST" class="announcement-form"><input class="form-input" name="title" maxlength="160" required placeholder="Announcement title"><textarea class="form-input" name="message" maxlength="500" required rows="3" placeholder="Write the announcement..."></textarea><input class="form-input" name="link" maxlength="300" placeholder="Optional link"><button class="btn btn-blue">Send to Students</button></form></section><section class="white-card"><h2>Recent Users</h2><div class="mini-course-list"><%recentUsers.forEach(u=>{%><div class="mini-course"><div class="avatar"><%=u.name.charAt(0).toUpperCase()%></div><div><strong><%=u.name%></strong><span><%=u.email%></span></div><b><%=u.role%></b></div><%})%></div></section></div>
<% } else if(role==='teacher'){ %>
<div class="dashboard-hero"><div><span class="eyebrow">INSTRUCTOR DASHBOARD</span><h1>Welcome, <%=name%> 👋</h1><p>Create engaging courses and track your learners.</p></div><a class="btn btn-blue" href="/courses/add">➕ Create Course</a></div>
<div class="stats-grid"><div class="stat-card"><div class="stat-icon">📚</div><div><div class="stat-value"><%=totalCourses%></div><div class="stat-label">Total Courses</div></div></div><div class="stat-card orange"><div class="stat-icon">🎓</div><div><div class="stat-value"><%=totalStudents%></div><div class="stat-label">Total Students</div></div></div><div class="stat-card"><div class="stat-icon">🧑‍🎓</div><div><div class="stat-value"><%=totalEnrollments%></div><div class="stat-label">Total Enrollments</div></div></div><div class="stat-card green"><div class="stat-icon">⭐</div><div><div class="stat-value"><%=Number(averageRating||0).toFixed(1)%></div><div class="stat-label">Average Rating</div></div></div></div>
<div class="white-card"><div class="page-header"><div><h2>Course Performance</h2><p class="muted">Enrollment, completion and review performance.</p></div></div><div class="table-wrapper"><table class="data-table"><thead><tr><th>Course</th><th>Status</th><th>Students</th><th>Completion</th><th>Rating</th><th>Actions</th></tr></thead><tbody><%coursePerformance.forEach(c=>{%><tr><td><strong><%=c.title%></strong><br><small><%=c.category%> · <%=c.level%></small></td><td><span class="badge badge-<%=c.status==='published'?'blue':'gray'%>"><%=c.status%></span></td><td><%=c.enrollmentCount%></td><td><%=c.completionRate%>%</td><td>⭐ <%=Number(c.rating||0).toFixed(1)%> (<%=c.reviewCount%>)</td><td><div class="table-actions"><a class="btn btn-blue btn-sm" href="/courses/<%=c._id%>/edit">Edit</a><a class="btn btn-ghost btn-sm" href="/instructor/courses/<%=c._id%>/students">Students</a><a class="btn btn-ghost btn-sm" href="/courses/<%=c._id%>">Reviews</a></div></td></tr><%})%><%if(!coursePerformance.length){%><tr><td colspan="6" style="text-align:center">No courses yet. Create your first course.</td></tr><%}%></tbody></table></div></div>
<div class="white-card" style="margin-top:24px"><h2>📢 Announcement</h2><p class="muted">Share important updates with all students.</p><form action="/admin/announcements" method="POST" class="announcement-form"><input class="form-input" name="title" required placeholder="Announcement title"><textarea class="form-input" name="message" required placeholder="Announcement message"></textarea><button class="btn btn-blue">Send Announcement</button></form></div>
<% } else { %>
<div class="dashboard-hero"><div><span class="eyebrow">LEARNING DASHBOARD</span><h1>Welcome back, <%=name%> 👋</h1><p>Continue learning or discover your next course.</p></div><a class="btn btn-blue" href="/courses">Browse Courses</a></div>
<div class="stats-grid"><div class="stat-card"><div class="stat-icon">📈</div><div><div class="stat-value"><%=overallProgress%>%</div><div class="stat-label">Overall Progress</div></div></div><div class="stat-card green"><div class="stat-icon">📅</div><div><div class="stat-value"><%=attendancePercent%>%</div><div class="stat-label">Attendance</div></div></div><div class="stat-card orange"><div class="stat-icon">🔥</div><div><div class="stat-value"><%=streak%> days</div><div class="stat-label">Learning Streak</div></div></div><div class="stat-card"><div class="stat-icon">⏱</div><div><div class="stat-value"><%=Math.floor(learningMinutes/60)%>h <%=learningMinutes%60%>m</div><div class="stat-label">Learning Time</div></div></div></div>
<div class="quick-actions"><a class="btn btn-blue" href="/analytics">📊 My Performance</a><a class="btn btn-ghost" href="/calendar">📅 Calendar</a><a class="btn btn-ghost" href="/my-learning-tools">🔖 Bookmarks · Notes · Badges</a><a class="btn btn-ghost" href="/messages">💬 Messages</a></div>
<div class="student-stat-grid"><div class="student-stat-card"><span>🎓</span><div><strong><%=enrolledCourses.length%></strong><span>Enrolled Courses</span></div></div><div class="student-stat-card"><span>🏆</span><div><strong><%=completedCourses%></strong><span>Completed</span></div></div><div class="student-stat-card"><span>📖</span><div><strong><%=inProgressCourses%></strong><span>In Progress</span></div></div><div class="student-stat-card"><span>📈</span><div><strong><%=overallProgress%>%</strong><span>Overall Progress</span></div></div></div>
<div class="student-section"><div class="section-heading"><div><h2>Continue Learning</h2><p>Jump back into your latest lesson.</p></div></div><%if(continueLearning){%><div class="continue-card"><div class="continue-thumb" style="background-image:url('<%=continueLearning.thumbnail||''%>')">▶</div><div class="continue-info"><span class="course-tag"><%=continueLearning.category%></span><h3><%=continueLearning.title%></h3><p><%=continueLearning.currentLessonTitle||'Start your first lesson'%></p><div class="progress-wrap"><div><span>Progress</span><strong><%=continueLearning.progressPercent%>%</strong></div><div class="progress-bar"><i style="width:<%=continueLearning.progressPercent%>%"></i></div></div><a class="btn btn-blue" href="/courses/<%=continueLearning._id%>/learn?lesson=<%=continueLearning.currentLesson||0%>">Continue Learning →</a></div></div><%}else{%><div class="empty-dashboard-card"><span>🚀</span><h3>Ready to start learning?</h3><p>Enroll in a course to begin.</p><a class="btn btn-blue" href="/courses">Explore Courses</a></div><%}%></div>
<div class="student-section"><div class="section-heading"><div><h2>My Courses</h2></div><a class="btn btn-ghost btn-sm" href="/my-courses">View All</a></div><%if(enrolledCourses.length){%><div class="course-grid"><%enrolledCourses.slice(0,6).forEach(c=>{%><div class="course-card"><div class="course-card-top" style="background-image:url('<%=c.thumbnail||''%>')"></div><div class="course-card-body"><span class="course-tag"><%=c.category%></span><h3><%=c.title%></h3><p><%=c.teacherName%></p><div class="progress-wrap"><div><span>Progress</span><strong><%=c.progressPercent%>%</strong></div><div class="progress-bar"><i style="width:<%=c.progressPercent%>%"></i></div></div></div><div class="course-card-actions"><a class="btn btn-blue btn-sm" href="/courses/<%=c._id%>/learn?lesson=<%=c.currentLesson||0%>">Continue</a></div></div><%})%></div><%}else{%><div class="empty-dashboard-card"><span>📚</span><p>No courses enrolled yet.</p><a class="btn btn-blue" href="/courses">Browse Courses</a></div><%}%></div>
<div class="student-section"><div class="section-heading"><div><h2>Recommended Courses</h2></div></div><div class="course-grid"><%recommendedCourses.forEach(c=>{%><div class="course-card"><div class="course-card-top" style="background-image:url('<%=c.thumbnail||''%>')"></div><div class="course-card-body"><span class="course-tag"><%=c.category%></span><h3><%=c.title%></h3><p><%=c.teacherName%></p><div class="course-meta"><span>📚 <%=c.lessonCount%> lessons</span><span>⭐ <%=Number(c.rating||0).toFixed(1)%></span></div></div><div class="course-card-actions"><a class="btn btn-ghost btn-sm" href="/courses/<%=c._id%>">View Course</a></div></div><%})%></div></div>
<% } %></main></body></html>
