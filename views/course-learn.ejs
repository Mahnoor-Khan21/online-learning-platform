<!DOCTYPE html>
<html lang="en">
<head>
    <script>(function(){try{var t=localStorage.getItem('learnhub-theme');if(!t&&window.matchMedia)t=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>

<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Learning — <%= course.title %></title><link rel="stylesheet" href="/style.css?v=3">
</head>
<body class="app-body">
<%- include('_navbar',{active:'courses',name,role}) %>
<main class="page-content learn-page">
<a class="back-link" href="/courses/<%=course._id%>">← Course Overview</a>
<div class="learn-shell">
<aside class="learn-sidebar white-card">
  <div class="learn-sidebar-head">
    <span class="course-tag"><%=course.category%></span>
    <h2><%=course.title%></h2>
    <div class="sidebar-progress">
      <div><span>Course progress</span><strong><%=progressPercent%>%</strong></div>
      <div class="progress-bar"><i style="width:<%=progressPercent%>%"></i></div>
    </div>
  </div>
  <div class="lesson-list">
  <% (course.lessons||[]).forEach((l,i)=>{ const done=completedLessons.includes(i); const hasVideo=Boolean(l.videoUrl && l.videoUrl.trim()); %>
    <a class="lesson-nav <%= i===lessonIndex?'active':'' %> <%=done?'done':''%>" href="/courses/<%=course._id%>/learn?lesson=<%=i%>">
      <span class="lesson-nav-icon"><%=done?'✓':(hasVideo?'▶':i+1)%></span>
      <span class="lesson-nav-copy">
        <strong><%=l.title%></strong>
        <small><%=l.duration || '10 min'%> <%= hasVideo ? '• 📹 Video' : '' %></small>
      </span>
    </a>
  <% }) %>
  <% if(!course.lessons || !course.lessons.length){ %><div class="empty-state compact"><div>📝</div><h3>No lessons yet</h3></div><% } %>
  </div>
</aside>

<section class="learn-main">
<% if(currentLesson){ %>
  <div class="video-card white-card">
    <div class="video-player">
    <% 
      const rawVideo = (currentLesson.videoUrl || '').trim();
      const yt = rawVideo.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([^&?/]+)/i); 
      let posterUrl = '';
      if (rawVideo.includes('cloudinary.com')) {
        posterUrl = rawVideo.replace(/\.(mp4|webm|mov|avi|mkv)$/i, '.jpg');
      } else if (course.thumbnail) {
        posterUrl = course.thumbnail;
      }
    %>
    <% if(yt){ %>
      <iframe src="https://www.youtube.com/embed/<%=yt[1]%>?rel=0" title="<%=currentLesson.title%>" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
    <% } else if(rawVideo){ %>
      <video id="lessonVideo" src="<%=rawVideo%>" controls playsinline preload="metadata" crossorigin="anonymous" <%= posterUrl ? 'poster="' + posterUrl + '"' : '' %>>
        <source src="<%=rawVideo%>" type="video/mp4">
        <source src="<%=rawVideo%>" type="video/webm">
        Your browser does not support video playback.
      </video>
    <% } else { %>
      <div class="video-placeholder">
        <div>▶</div>
        <strong>Text Lesson / Reading Material</strong>
        <span>No video attachment for this lesson. Read the instructions below.</span>
      </div>
    <% } %>
    </div>
    <div class="lesson-heading">
      <div>
        <div class="lesson-counter-wrap">
          <span class="lesson-counter">Lesson <%=lessonIndex+1%> of <%=course.lessons.length%></span>
          <% if(rawVideo){ %><span class="badge badge-blue">📹 Video Included</span><% } %>
          <% if(rawVideo && !yt){ %><span class="badge badge-gray" id="videoDurationBadge">⏱ <span id="videoDurationText"><%= currentLesson.duration || '...' %></span></span><% } else if(currentLesson.duration){ %><span class="badge badge-gray">⏱ <%=currentLesson.duration%></span><% } %>
        </div>
        <h1><%=currentLesson.title%></h1>
      </div>
      <% if(completedLessons.includes(lessonIndex)){ %><span class="completed-pill">✓ Completed</span><% } %>
    </div>
    <% if(currentLesson.description){ %><p class="lesson-description"><%=currentLesson.description%></p><% } %>
    <% if(currentLesson.content){ %><div class="lesson-content-box"><%=currentLesson.content%></div><% } %>
    <% if(course.quizzes && course.quizzes.length){ %>
      <div class="quiz-launch-row" style="margin:20px 0; background:rgba(13,148,136,0.08); padding:16px; border-radius:14px; border:1px solid rgba(13,148,136,0.2); display:flex; align-items:center; justify-space-between; flex-wrap:wrap; gap:12px">
        <div>
          <strong style="color:var(--text); font-size:1.05rem; display:block">📝 Course Assessment Quiz</strong>
          <span style="font-size:0.88rem; color:var(--muted)">Test your knowledge and unlock your official completion certificate.</span>
        </div>
        <a class="btn btn-blue" style="margin-left:auto" href="/courses/<%=course._id%>/quiz">Take Course Quiz →</a>
      </div>
    <% } %>
    <div class="learning-actions">
      <% if(lessonIndex>0){ %><a class="btn btn-ghost" href="/courses/<%=course._id%>/learn?lesson=<%=lessonIndex-1%>">← Previous Lesson</a><% } else { %><span></span><% } %>
      <% if(typeof isEnrolled !== 'undefined' && isEnrolled){ %>
        <form action="/courses/<%=course._id%>/lessons/<%=lessonIndex%>/toggle" method="POST">
          <button class="btn <%=completedLessons.includes(lessonIndex)?'btn-ghost':'btn-blue'%> complete-lesson-btn"><%=completedLessons.includes(lessonIndex)?'✓ Completed — Mark Incomplete':'✓ Mark Lesson as Complete'%></button>
        </form>
      <% } else { %>
        <span class="badge badge-blue">Preview Mode</span>
      <% } %>
      <% if(lessonIndex<course.lessons.length-1){ %><a class="btn btn-blue" href="/courses/<%=course._id%>/learn?lesson=<%=lessonIndex+1%>">Next Lesson →</a><% } else if(course.quizzes && course.quizzes.length) { %><a class="btn btn-green" href="/courses/<%=course._id%>/quiz">Complete &amp; Take Quiz 📝 →</a><% } else { %><a class="btn btn-blue" href="/courses/<%=course._id%>">Course Overview</a><% } %>
    </div>
  </div>
<% } else { %><div class="white-card empty-state"><div>🎓</div><h2>Your course is ready</h2><p>The instructor hasn't added any lessons yet.</p></div><% } %>
</section>
</div>
</main>
</body>
<script>
// ── Real video duration from actual video file ──
(function(){
  const video = document.getElementById('lessonVideo');
  const durationText = document.getElementById('videoDurationText');
  if(!video || !durationText) return;

  function formatDuration(seconds){
    if(!seconds || isNaN(seconds)) return null;
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    const s = Math.floor(seconds % 60);
    if(h > 0) return h + 'h ' + m + 'm';
    if(m > 0) return m + ' min ' + (s > 0 ? s + ' sec' : '');
    return s + ' sec';
  }

  function applyDuration(){
    const dur = video.duration;
    if(dur && !isNaN(dur) && isFinite(dur)){
      const formatted = formatDuration(dur);
      if(formatted) durationText.textContent = formatted;
    }
  }

  if(video.readyState >= 1 && video.duration){
    applyDuration();
  } else {
    video.addEventListener('loadedmetadata', applyDuration);
    video.addEventListener('durationchange', applyDuration);
  }
})();
</script>
</html>
