<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=course.title%> — LearnHub</title><link rel="stylesheet" href="/style.css"></head><body class="app-body"><%- include('_navbar',{active:'courses',name,role}) %><main class="page-content"><% const currentReview = (course.reviews||[]).find(r => r.userId && r.userId.toString() === (typeof userId !== 'undefined' ? userId.toString() : '')); %><a class="back-link" href="/courses">← Back to Courses</a><div class="course-hero"><div class="course-hero-media"><% if(course.thumbnail){ %><img src="<%=course.thumbnail%>" alt="<%=course.title%>"><% } else { %><span>🎓</span><% } %></div><div><div class="course-topline"><span class="course-tag"><%=course.category%></span><span class="course-level"><%=course.level%></span><% if(course.status && course.status !== 'published'){ %><span class="badge badge-orange"><%=course.status%></span><% } %></div><h1><%=course.title%></h1><p><%=course.description%></p><div class="course-meta large"><span>⭐ <strong><%=Number(course.rating||0).toFixed(1)%></strong> (<%=course.reviews.length%> reviews)</span><span>📖 <%=course.lessons.length%> lessons</span><span>👨‍🎓 <%=course.enrolledStudents.length%> enrolled</span><span>⏱ <%=course.duration%></span></div></div></div>
<div class="course-detail-grid"><div><section class="white-card detail-section"><h2>What you'll learn</h2><ul class="learning-list"><% (course.learningOutcomes||[]).forEach(x=>{ %><li>✓ <%=x%></li><% }) %><% if(!(course.learningOutcomes||[]).length){ %><li>Build practical knowledge through the complete course curriculum.</li><% } %></ul></section><section class="white-card detail-section"><h2>Course Curriculum</h2><div class="curriculum"><% course.lessons.forEach((l,i)=>{ %><div class="lesson-row"><span class="lesson-number"><%=i+1%></span><div><strong><%=l.title%></strong><small><%=l.description||'Lesson content and practical learning material.'%></small></div><span><%=l.duration%></span></div><% }) %><% if(!course.lessons.length){ %><p class="muted">Curriculum will be added by the instructor.</p><% } %></div></section><section class="white-card detail-section instructor-box"><h2>Instructor</h2><div class="instructor"><% if(instructor.profilePicture){ %><img src="<%=instructor.profilePicture%>" alt="<%=instructor.name%>"><% } else { %><div class="avatar-fallback">👤</div><% } %><div><h3><%=instructor.name%></h3><p><%=instructor.bio||'Course instructor at LearnHub.'%></p></div></div></section><section id="reviews" class="white-card detail-section">
<h2>Reviews &amp; Ratings</h2>
<div class="rating-summary"><div class="rating-score"><strong><%=Number(course.rating||0).toFixed(1)%></strong><span>/ 5</span></div><div><div class="rating-stars"><%= '★'.repeat(Math.round(Number(course.rating||0))) %><%= '☆'.repeat(5-Math.round(Number(course.rating||0))) %></div><p><%=course.reviews.length%> review<%=course.reviews.length===1?'':'s'%></p></div></div>
<% if(role==='student'&&isEnrolled){ %><form action="/courses/<%=course._id%>/review" method="POST" class="review-form">
<div class="field"><label for="review-rating"><%=currentReview?'Edit your rating':'Your rating'%></label><select id="review-rating" name="rating" required><option value="">Choose rating</option><% [5,4,3,2,1].forEach(x=>{ %><option value="<%=x%>" <%=currentReview&&currentReview.rating===x?'selected':''%>><%=x%> / 5 — <%= '★'.repeat(x) %></option><% }) %></select></div>
<div class="field"><label for="review-comment">Written review</label><textarea id="review-comment" name="comment" maxlength="500" placeholder="Share your experience..."><%=currentReview?.comment||''%></textarea><small class="muted">Up to 500 characters.</small></div>
<button class="btn btn-blue" type="submit"><%=currentReview?'Update Review':'Submit Review'%></button>
<% if(currentReview){ %><span class="badge badge-blue">You have already reviewed this course</span><% } %></form><% } %>
<div class="reviews-list">
<% if(course.reviews.length){ course.reviews.slice().reverse().forEach(r=>{ %><article class="review"><div class="review-header"><% if(r.profilePicture){ %><img class="review-avatar" src="<%=r.profilePicture%>" alt="<%=r.userName%>"><% } else { %><div class="review-avatar review-avatar-fallback"><%=String(r.userName||'U').charAt(0).toUpperCase()%></div><% } %><div class="review-author"><strong><%=r.userName%></strong><div class="review-stars"><%= '★'.repeat(r.rating) %><%= '☆'.repeat(5-r.rating) %></div></div><time><%=new Date(r.createdAt).toLocaleDateString()%></time></div><p><%=r.comment||'No written comment.'%></p><% if(role==='student' && currentReview && r.userId && r.userId.toString()===currentReview.userId.toString()){ %><div class="review-actions"><a class="btn btn-ghost" href="#reviews">Edit Review</a><form action="/courses/<%=course._id%>/review/delete" method="POST" onsubmit="return confirm('Delete your review?')"><button class="btn btn-red" type="submit">Delete Review</button></form></div><% } %></article><% }) } else { %><p class="muted">No reviews yet. Be the first to review this course.</p><% } %></div>
</section></div><aside class="white-card enroll-card"><div class="enroll-thumb"><% if(course.thumbnail){ %><img src="<%=course.thumbnail%>" alt="<%=course.title%>"><% } else { %>🎓<% } %></div><h2><%=course.title%></h2><p>By <strong><%=course.teacherName%></strong></p><div class="enroll-stats"><span>📖 <b><%=course.lessons.length%></b> lessons</span><span>⭐ <b><%=Number(course.rating||0).toFixed(1)%></b> rating</span></div><% if(role==='student'){ %><% if(isEnrolled){ %><div class="enrolled-state">✓ Already Enrolled<div class="progress-wrap"><div><span>Progress</span><strong><%=progressPercent%>%</strong></div><div class="progress-bar"><i style="width:<%=progressPercent%>%"></i></div></div></div><a href="/courses/<%=course._id%>/learn" class="btn btn-blue btn-full"><%=progressPercent?'Continue Learning':'Start Learning'%> →</a><% if(certificate){ %><a href="/courses/<%=course._id%>/certificate" class="btn btn-green btn-full" style="margin-top:10px">🏆 View Certificate</a><% } else if(certificateEligibility && certificateEligibility.allLessonsComplete && !certificateEligibility.quizPassed){ %><div class="certificate-locked">🏆 Certificate unlocks after you pass the required quiz.</div><% } %><form action="/courses/<%=course._id%>/unenroll" method="POST" onsubmit="return confirm('Leave this course?')"><button class="btn btn-ghost btn-full" style="margin-top:10px">Leave Course</button></form><% } else { %><form action="/courses/<%=course._id%>/enroll" method="POST"><button class="btn btn-blue btn-full big-btn">Enroll Now — Free</button></form><% } %><% } else if(isOwner||role==='admin'){ %><span class="badge badge-blue">Instructor / Admin View</span><div class="table-actions" style="margin-top:12px"><a href="/courses/<%=course._id%>/edit" class="btn btn-blue btn-full">✏️ Edit Course</a></div><form action="/courses/<%=course._id%>/delete" method="POST" onsubmit="return confirm('Delete this course?')"><button class="btn btn-red btn-full" style="margin-top:12px">Delete Course</button></form><% } %></aside></div></main></body></html>
