<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= course.title %> — LearnHub</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="app-body">

    <%- include('_navbar', { active: 'courses', name, role }) %>

    <div class="page-content">

        <!-- Back link -->
        <a href="/courses" style="display:inline-flex; align-items:center; gap:6px; color:#6b7280; text-decoration:none; margin-bottom:20px; font-size:.9rem;">
            ← Back to Courses
        </a>

        <!-- Two-column layout: course info (left) + action card (right) -->
        <div style="display:grid; grid-template-columns: 1fr 300px; gap:24px; align-items:start;">

            <!-- ── LEFT: Course details ── -->
            <div>
                <div class="white-card" style="margin-bottom:20px;">

                    <!-- Category + Level -->
                    <div style="display:flex; gap:8px; margin-bottom:14px; flex-wrap:wrap;">
                        <span class="badge badge-blue"><%= course.category %></span>
                        <span class="badge" style="background:#f3f4f6; color:#374151;"><%= course.level %></span>
                    </div>

                    <!-- Title -->
                    <h1 style="font-size:1.8rem; font-weight:800; color:#1e2447; margin-bottom:12px; line-height:1.3;">
                        <%= course.title %>
                    </h1>

                    <!-- Meta row -->
                    <div style="display:flex; gap:20px; flex-wrap:wrap; margin-bottom:20px; font-size:.9rem; color:#6b7280;">
                        <span>👩‍🏫 <strong style="color:#1e2447;"><%= course.teacherName %></strong></span>
                        <span>🕐 <%= course.duration %></span>
                        <span>👨‍🎓 <%= course.enrolledStudents.length %> students enrolled</span>
                    </div>

                    <!-- Divider -->
                    <hr style="border:none; border-top:1px solid #e5e7eb; margin-bottom:20px;">

                    <!-- Description -->
                    <h2 style="font-size:1rem; font-weight:700; margin-bottom:10px;">About this Course</h2>
                    <p style="color:#4b5563; line-height:1.8; font-size:.95rem;">
                        <%= course.description %>
                    </p>

                </div>
            </div>

            <!-- ── RIGHT: Action card ── -->
            <div class="white-card" style="text-align:center; padding:28px 24px;">

                <div style="font-size:3rem; margin-bottom:12px;">📚</div>
                <h3 style="font-size:1.05rem; font-weight:700; margin-bottom:6px;"><%= course.title %></h3>
                <p style="font-size:.85rem; color:#6b7280; margin-bottom:20px;">By <%= course.teacherName %></p>

                <hr style="border:none; border-top:1px solid #e5e7eb; margin-bottom:20px;">

                <!-- STUDENT: Enroll / Unenroll buttons -->
                <% if (role === 'student') { %>

                    <% if (isEnrolled) { %>
                        <!-- Already enrolled — show unenroll option -->
                        <div class="badge badge-blue" style="font-size:.9rem; padding:8px 18px; margin-bottom:16px; display:inline-flex;">
                            ✓ You are enrolled
                        </div>
                        <br>
                        <form action="/courses/<%= course._id %>/unenroll" method="POST" style="margin-top:12px;">
                            <button type="submit" class="btn btn-red btn-full">Leave Course</button>
                        </form>

                    <% } else { %>
                        <!-- Not enrolled yet -->
                        <form action="/courses/<%= course._id %>/enroll" method="POST">
                            <button type="submit" class="btn btn-blue btn-full" style="font-size:1rem; padding:14px;">
                                Enroll Now — Free
                            </button>
                        </form>
                    <% } %>

                <!-- TEACHER who owns this course or ADMIN: see delete button -->
                <% } else if (isOwner || role === 'admin') { %>

                    <div class="badge" style="background:#fff7ed; color:#92400e; margin-bottom:16px; display:inline-flex; padding:6px 14px;">
                        <% if (isOwner) { %> 📗 Your Course <% } else { %> 🛡️ Admin View <% } %>
                    </div>
                    <form action="/courses/<%= course._id %>/delete" method="POST"
                          onsubmit="return confirm('Delete this course? This cannot be undone.')">
                        <button type="submit" class="btn btn-red btn-full">🗑️ Delete Course</button>
                    </form>

                <!-- Other teacher: just info -->
                <% } else { %>
                    <p style="color:#6b7280; font-size:.9rem;">Only students can enroll in courses.</p>
                <% } %>

            </div>

        </div>

    </div>

    <!-- Make the layout stack on mobile -->
    <style>
        @media (max-width: 700px) {
            .page-content > div[style*="grid"] {
                grid-template-columns: 1fr !important;
            }
        }
    </style>

</body>
</html>
