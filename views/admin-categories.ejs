<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Categories — LearnHub</title><link rel="stylesheet" href="/style.css"></head><body class="app-body"><%-include('_navbar',{active:'admin',name,role})%><main class="page-content"><div class="page-header"><div><h1 class="page-title">Course Categories</h1><p class="page-subtitle">Manage categories used by instructors.</p></div></div><div class="white-card"><form action="/admin/categories" method="POST" class="inline-form"><input class="form-input" name="name" required maxlength="80" placeholder="New category"><button class="btn btn-blue">Add Category</button></form><div class="chip-list"><%categories.forEach(c=>{%><div class="chip"><%=c.name%><form action="/admin/categories/<%=c._id%>/delete" method="POST" onsubmit="return confirm('Delete this category?')"><button class="chip-x">×</button></form></div><%})%></div></div></main></body></html>
