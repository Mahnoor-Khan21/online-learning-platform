<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Notifications — LearnHub</title><link rel="stylesheet" href="/style.css"></head><body class="app-body"><%-include('_navbar',{active:'admin',name,role})%><main class="page-content"><div class="page-header"><div><h1 class="page-title">Notification Management</h1><p class="page-subtitle">Recent platform notifications.</p></div><form action="/admin/notifications/clear" method="POST" onsubmit="return confirm('Delete all notifications?')"><button class="btn btn-red">Clear All</button></form></div><div class="white-card"><div class="notifications-page"><%notifications.forEach(n=>{%><div class="notification-page-item <%=n.readAt?'':'is-unread'%>"><strong><%=n.title%></strong><span><%=n.message%></span><small>User: <%=n.userId%> · <%=new Date(n.createdAt).toLocaleString()%></small></div><%})%><%if(!notifications.length){%><div class="empty-dashboard-card"><span>🔔</span><p>No notifications.</p></div><%}%></div></div></main></body></html>
