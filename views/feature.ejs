<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=title%> — LearnHub</title><link rel="stylesheet" href="/style.css"></head>
<body class="app-body"><%-include('_navbar',{active:'dashboard',name,role})%><main class="page-content">
<a class="back-link" href="/dashboard">← Dashboard</a><div class="page-header"><div><h1 class="page-title"><%=title%></h1><p class="page-subtitle">Professional learning tools and platform management.</p></div></div>

<% if(section==='attendance'){ %>
<div class="feature-grid"><section class="white-card"><h2>📊 Attendance</h2><% if(role==='teacher'){ %><form action="/courses/<%=course._id%>/attendance/mark" method="POST" class="feature-form"><select name="studentId" required><option value="">Select student</option><%students.forEach(s=>{%><option value="<%=s._id%>"><%=s.name%> — <%=s.email%></option><%})%></select><select name="status"><option value="present">Present</option><option value="absent">Absent</option></select><input type="date" name="date" required><input name="lessonIndex" type="number" min="0" placeholder="Lesson # (optional)"><button class="btn btn-blue">Mark Attendance</button></form><% } %></section></div>
<div class="white-card table-wrapper"><table class="data-table"><thead><tr><th>Student</th><th>Present</th><th>Absent</th><th>Attendance</th></tr></thead><tbody><%rows.forEach(r=>{%><tr><td><%=r.student?.name||'You'%></td><td><%=r.present%></td><td><%=r.absent%></td><td><strong><%=r.percentage%>%</strong><div class="progress-bar"><i style="width:<%=r.percentage%>%"></i></div></td></tr><%})%></tbody></table></div>
<% } else if(section==='admin-attendance'){ %>
<div class="white-card table-wrapper"><table class="data-table"><thead><tr><th>Date</th><th>Course</th><th>Student</th><th>Status</th><th>Marked By</th></tr></thead><tbody><%records.forEach(r=>{%><tr><td><%=new Date(r.date).toLocaleDateString()%></td><td><%=r.courseId?.title||'—'%></td><td><%=r.studentId?.name||'—'%></td><td><span class="badge badge-<%=r.status==='present'?'blue':'orange'%>"><%=r.status%></span></td><td><%=r.markedBy?.name||'—'%></td></tr><%})%></tbody></table></div>

<% } else if(section==='calendar'){ %>
<div class="stats-grid"><div class="stat-card"><div class="stat-icon">📅</div><div><div class="stat-value"><%=classes.filter(c=>new Date(c.date)>=now&&c.status!=='cancelled').length%></div><div class="stat-label">Upcoming Classes</div></div></div><div class="stat-card"><div class="stat-icon">📝</div><div><div class="stat-value"><%=quizzes.length%></div><div class="stat-label">Quiz Activity</div></div></div></div>
<% if(role==='teacher'){ %><section class="white-card"><h2>➕ Schedule Live Class</h2><form action="/instructor/classes/create" method="POST" class="feature-form"><select name="courseId" required><option value="">Choose course</option><% (typeof courses!=='undefined'?courses:[]).forEach(c=>{%><option value="<%=c._id%>"><%=c.title%></option><%})%></select><input name="title" placeholder="Class title" required><input name="date" type="datetime-local" required><input name="durationMinutes" type="number" value="60" min="15"><input name="meetingLink" placeholder="Meeting link"><button class="btn btn-blue">Schedule Class</button></form></section><% } %>
<div class="white-card"><h2>📆 Upcoming & Past Classes</h2><div class="event-list"><%classes.forEach(c=>{%><article class="event-card"><div><strong><%=c.title%></strong><span><%=c.courseId?.title%> · <%=new Date(c.date).toLocaleString()%></span><small>👨‍🏫 <%=c.teacherId?.name||'Instructor'%> · <%=c.status%></small></div><%if(c.status==='upcoming'&&c.meetingLink){%><a class="btn btn-blue" href="<%=c.meetingLink%>" target="_blank" rel="noopener">Join Class</a><%}%></article><%})%></div></div>

<% } else if(section==='assignments'){ %>
<%if(role==='teacher'){%><section class="white-card"><h2>➕ Create Assignment</h2><form action="/courses/<%=course._id%>/assignments/create" method="POST" enctype="multipart/form-data" class="feature-form"><input name="title" required placeholder="Assignment title"><textarea name="description" rows="3" placeholder="Description"></textarea><input name="dueDate" type="datetime-local" required><input name="maxMarks" type="number" value="100" min="1"><input name="attachment" type="file"><button class="btn btn-blue">Create Assignment</button></form></section><%}%>
<div class="feature-grid"><%assignments.forEach(a=>{%><article class="white-card"><h3><%=a.title%></h3><p><%=a.description%></p><p>📅 Due: <%=new Date(a.dueDate).toLocaleString()%> · 🎯 <%=a.maxMarks%> marks</p><%if(a.attachmentUrl){%><a href="<%=a.attachmentUrl%>" download="<%=a.attachmentName%>">📎 <%=a.attachmentName%></a><%}%><%if(role==='student'){const sub=subMap[String(a._id)];%><form action="/assignments/<%=a._id%>/submit" method="POST" enctype="multipart/form-data" class="feature-form"><textarea name="text" placeholder="Your submission..."><%=sub?.text||''%></textarea><input name="file" type="file"><button class="btn btn-blue"><%=sub?'Update Submission':'Submit Assignment'%></button></form><%if(sub?.marks!=null){%><div class="result-box">Grade: <strong><%=sub.marks%>/<%=a.maxMarks%></strong><br><%=sub.feedback||'No feedback'%></div><%}}else{%><a class="btn btn-ghost" href="/assignments/<%=a._id%>/submissions">View Submissions & Grade</a><%}%></article><%})%></div>

<% } else if(section==='grade-assignment'){ %>
<div class="white-card"><h2><%=assignment.title%> — Submissions</h2><%submissions.forEach(s=>{%><article class="submission-card"><div><strong><%=s.studentId?.name%></strong><span><%=s.studentId?.email%> · <%=new Date(s.submittedAt).toLocaleString()%></span><p><%=s.text%></p><%if(s.fileUrl){%><a href="<%=s.fileUrl%>" download="<%=s.fileName%>">📎 <%=s.fileName%></a><%}%></div><form action="/assignments/<%=assignment._id%>/submissions/<%=s._id%>/grade" method="POST" class="feature-form inline"><input type="number" name="marks" min="0" max="<%=assignment.maxMarks%>" value="<%=s.marks??''%>" placeholder="Marks"><input name="feedback" value="<%=s.feedback||''%>" placeholder="Feedback"><button class="btn btn-blue">Save Grade</button></form></article><%})%></div>

<% } else if(section==='resources'){ %>
<%if(role==='teacher'){%><section class="white-card"><h2>➕ Add Lesson Resource</h2><form action="/courses/<%=course._id%>/resources/add" method="POST" class="feature-form"><select name="lessonIndex" required><%course.lessons.forEach((l,i)=>{%><option value="<%=i%>"><%=i+1%>. <%=l.title%></option><%})%></select><input name="name" required placeholder="Resource name, e.g. Lecture Notes.pdf"><input name="type" placeholder="Type (PDF, PPT, ZIP)"><input name="url" placeholder="Public resource URL"><input name="file" type="file"><button class="btn btn-blue">Add Resource</button></form></section><%}%>
<div class="feature-grid"><%resources.forEach(r=>{%><article class="white-card"><div class="resource-icon">📄</div><h3><%=r.name%></h3><p><%=r.lessonTitle%> · <%=r.type||'Resource'%></p><a class="btn btn-blue" href="<%=r.url%>" download>Download Resource</a></article><%})%></div><%if(!resources.length){%><div class="white-card empty-state"><h2>No resources yet</h2><p>Instructors can attach learning materials to lessons.</p></div><%}%>

<% } else if(section==='discussion'){ %>
<section class="white-card"><h2>💬 Start a Discussion</h2><form action="/courses/<%=course._id%>/discussion" method="POST" class="feature-form"><input name="title" required placeholder="Question title"><textarea name="body" required rows="4" placeholder="Ask the community..."></textarea><button class="btn btn-blue">Post Question</button></form></section><div class="feature-grid"><%posts.forEach(p=>{%><article class="white-card"><h3><%=p.title%></h3><small>By <%=p.userName%> · <%=new Date(p.createdAt).toLocaleString()%> · ❤️ <%=p.likes.length%></small><p><%=p.body%></p><form action="/discussion/<%=p._id%>/like" method="POST"><button class="btn btn-ghost btn-sm">❤️ Like</button></form><form action="/discussion/<%=p._id%>/reply" method="POST" class="feature-form"><input name="body" placeholder="Reply..."><button class="btn btn-ghost">Reply</button></form><%if(role==='teacher'||role==='admin'){%><form action="/discussion/<%=p._id%>/answer" method="POST"><input type="hidden" name="answerId" value="<%=p._id%>"><button class="btn btn-green">✓ Mark as Answer</button></form><%}%></article><%})%></div>

<% } else if(section==='tools'){ %>
<div class="feature-grid"><section class="white-card"><h2>🔖 Bookmarks</h2><%bookmarks.forEach(b=>{%><p><a href="/courses/<%=b.courseId._id%>/learn?lesson=<%=b.lessonIndex%>"><%=b.courseId.title%> — <%=b.courseId.lessons[b.lessonIndex]?.title%></a></p><%})%></section><section class="white-card"><h2>📝 Notes</h2><%notes.forEach(n=>{%><article class="note-card"><strong><%=n.courseId.title%> — <%=n.courseId.lessons[n.lessonIndex]?.title%></strong><p><%=n.content%></p><form action="/notes/<%=n._id%>/delete" method="POST"><button class="btn btn-red btn-sm">Delete</button></form></article><%})%></section><section class="white-card"><h2>❤️ Wishlist</h2><%wishlist.forEach(w=>{%><p><a href="/courses/<%=w.courseId._id%>"><%=w.courseId.title%></a></p><%})%></section><section class="white-card"><h2>🏅 Badges</h2><div class="badge-list"><%badges.forEach(b=>{%><span class="achievement"><%=b.icon%> <%=b.name%></span><%})%></div><form action="/badges/check" method="POST"><button class="btn btn-blue">Check Achievements</button></form></section><section class="white-card"><h2>⏱ Learning Time</h2><strong><%=Math.floor(logs.reduce((n,x)=>n+x.minutes,0)/60)%>h <%=logs.reduce((n,x)=>n+x.minutes,0)%60%>m</strong><p class="muted">Keep learning every day to build your streak.</p></section></div>

<% } else if(section==='analytics'){ %>
<div class="stats-grid"><%[['📈','Course Progress',stats.progress+'%'],['📅','Attendance',stats.attendancePct+'%'],['📝','Quiz Average',stats.quizAvg+'%'],['🎯','Assignments',stats.assignAvg+'%'],['⏱','Learning Time',Math.floor(stats.learningMinutes/60)+'h '+stats.learningMinutes%60+'m']].forEach(x=>{%><div class="stat-card"><div class="stat-icon"><%=x[0]%></div><div><div class="stat-value"><%=x[2]%></div><div class="stat-label"><%=x[1]%></div></div></div><%})%></div>
<% } else if(section==='instructor-analytics'){ %>
<div class="stats-grid"><%[['👨‍🎓','Unique Students',stats.totalStudents],['🎓','Enrollments',stats.totalEnrollments],['🏆','Completion Rate',stats.completion+'%'],['📝','Quiz Average',stats.quizAvg+'%'],['📅','Attendance',stats.attendance+'%']].forEach(x=>{%><div class="stat-card"><div class="stat-icon"><%=x[0]%></div><div><div class="stat-value"><%=x[2]%></div><div class="stat-label"><%=x[1]%></div></div></div><%})%></div><div class="white-card"><h2>Course Performance</h2><div class="table-wrapper"><table class="data-table"><thead><tr><th>Course</th><th>Students</th><th>Rating</th><th>Completion</th></tr></thead><tbody><%courses.forEach(c=>{%><tr><td><%=c.title%></td><td><%=c.enrolledStudents.length%></td><td>⭐ <%=c.rating%></td><td><%=c.enrolledStudents.length?Math.round(c.completedStudents.length/c.enrolledStudents.length*100):0%>%</td></tr><%})%></tbody></table></div></div>

<% } else if(section==='instructor-profile'){ %>
<div class="course-hero"><div class="course-hero-media"><%if(instructor.profilePicture){%><img src="<%=instructor.profilePicture%>"><%}else{%><span>👨‍🏫</span><%}%></div><div><h1><%=instructor.name%></h1><p><%=instructor.bio||'Professional instructor at LearnHub.'%></p><p><strong>Expertise:</strong> <%=instructor.expertise||'Learning & Development'%></p><div class="course-meta large"><span>📚 <%=courses.length%> Courses</span><span>👨‍🎓 <%=stats.students%> Students</span><span>⭐ <%=stats.rating%> Rating</span><span>💬 <%=stats.reviewCount%> Reviews</span></div></div></div><div class="feature-grid"><%courses.forEach(c=>{%><a class="white-card" href="/courses/<%=c._id%>"><h3><%=c.title%></h3><p><%=c.description%></p></a><%})%></div>

<% } else if(section==='messages'){ %>
<div class="feature-grid"><section class="white-card"><h2>✉️ New Message</h2><form action="/messages" method="POST" class="feature-form"><select name="receiverId" required><option value="">Choose recipient</option><%users.forEach(u=>{%><option value="<%=u._id%>"><%=u.name%> — <%=u.role%></option><%})%></select><textarea name="body" required rows="5" placeholder="Write your message..."></textarea><button class="btn btn-blue">Send Message</button></form></section><section class="white-card"><h2>Inbox & Sent</h2><%messages.forEach(m=>{%><article class="message-card"><strong><%=m.senderId?.name%> → <%=m.receiverId?.name%></strong><small><%=new Date(m.createdAt).toLocaleString()%></small><p><%=m.body%></p><%if(String(m.receiverId?._id)===String(typeof userId!=='undefined'?userId:'')){%><form action="/messages/<%=m._id%>/read" method="POST"><button class="btn btn-ghost btn-sm"><%=m.readAt?'Read':'Mark Read'%></button></form><%}%></article><%})%></section></div>

<% } else if(section==='reports'){ %>
<div class="white-card table-wrapper"><table class="data-table"><thead><tr><th>Reporter</th><th>Course</th><th>Reason</th><th>Status</th><th>Action</th></tr></thead><tbody><%reports.forEach(r=>{%><tr><td><%=r.reporterId?.name%></td><td><%=r.courseId?.title||'—'%></td><td><strong><%=r.reason%></strong><br><small><%=r.details%></small></td><td><%=r.status%></td><td><%if(r.status==='open'){%><form action="/admin/reports/<%=r._id%>/resolve" method="POST"><button class="btn btn-green btn-sm">Resolve</button></form><%}%></td></tr><%})%></tbody></table></div>
<% } %>
</main></body></html>