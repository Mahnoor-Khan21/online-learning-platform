<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Notifications — LearnHub</title><link rel="stylesheet" href="/style.css"></head><body class="app-body"><%- include('_navbar', { active: 'notifications', name, role }) %><main class="page-content notifications-page"><div class="page-header"><div><h1 class="page-title">Notifications</h1><p class="muted">Stay up to date with your learning activity.</p></div><form action="/notifications/read-all" method="POST"><button class="btn btn-ghost">✓ Mark all as read</button></form></div><div class="notification-list-page"><% if (!notifications.length) { %><div class="white-card notification-empty"><div>🔔</div><h2>You're all caught up</h2><p>No notifications yet.</p></div><% } %><% notifications.forEach(n => { const icon = ({course:'📚',enrollment:'🎓',quiz:'📝',completion:'🏆',certificate:'📜',announcement:'📢',system:'🔔'})[n.type] || '🔔'; %><div class="notification-page-item <%= n.readAt ? 'is-read' : 'is-unread' %>"><div class="notification-icon notification-type-<%= n.type %>"><%= icon %></div><div class="notification-page-body"><div class="notification-page-top"><strong><%= n.title %></strong><time><%= new Date(n.createdAt).toLocaleString() %></time></div><p><%= n.message %></p><div class="notification-page-actions"><% if(n.link){ %><a href="<%= n.link %>" class="btn btn-sm btn-blue">View</a><% } %><% if(!n.readAt){ %><form action="/notifications/<%= n._id %>/read" method="POST"><button class="btn btn-sm btn-ghost">Mark as read</button></form><% } %></div></div></div><% }) %></div></main></body></html>
