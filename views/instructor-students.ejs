<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Course Students — LearnHub</title><link rel="stylesheet" href="/style.css"></head><body class="app-body"><%- include('_navbar',{active:'dashboard',name,role}) %><main class="page-content"><div class="page-header"><div><h1 class="page-title"><%=course.title%></h1><p class="page-subtitle">Enrolled students and learning progress.</p></div></div><div class="white-card"><div class="table-wrapper"><table class="data-table"><thead><tr><th>Student</th><th>Email</th><th>Progress</th><th>Status</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><div class="table-user"><%if(r.student?.profilePicture){%><img class="review-avatar" src="<%=r.student.profilePicture%>"><%}else{%><div class="avatar"><%=r.student?.name?.charAt(0).toUpperCase()||'?'%></div><%}%><%=r.student?.name||'Deleted user'%></div></td><td><%=r.student?.email||'—'%></td><td><div class="progress-wrap"><strong><%=r.progress%>%</strong><div class="progress-bar"><i style="width:<%=r.progress%>%"></i></div></div></td><td><span class="badge badge-<%=r.completed?'blue':'gray'%>"><%=r.completed?'Completed':'In progress'%></span></td></tr><% }) %><%if(!rows.length){%><tr><td colspan="4" style="text-align:center">No enrolled students yet.</td></tr><%}%></tbody></table></div></div></main></body></html>
