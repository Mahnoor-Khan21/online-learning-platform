<!DOCTYPE html>
<html lang="en">
<head>
    <script>(function(){try{var t=localStorage.getItem('learnhub-theme');if(!t&&window.matchMedia)t=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirm Logout — LearnHub</title>
    <link rel="stylesheet" href="/style.css?v=3">
</head>
<body class="auth-body">

    <div class="auth-card">
        <h2>Confirm Logout</h2>
        <p>Are you sure you want to logout?</p>

        <div class="button-row">
            <!-- YES — submits POST /logout to destroy session -->
            <form action="/logout" method="POST">
                <button type="submit" class="btn-primary">Yes, Logout</button>
            </form>
            <!-- CANCEL — go back to dashboard -->
            <a href="/dashboard" class="btn-secondary">Cancel</a>
        </div>
    </div>

</body>
</html>
