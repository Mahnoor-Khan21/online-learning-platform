<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Reviews — LearnHub</title><link rel="stylesheet" href="/style.css"></head><body class="app-body"><%-include('_navbar',{active:'admin',name,role})%><main class="page-content"><div class="page-header"><div><h1 class="page-title">Reviews</h1><p class="page-subtitle">Moderate course reviews.</p></div></div><div class="review-list"><%reviews.forEach(r=>{%><article class="white-card review"><div class="review-header"><%if(r.profilePicture){%><img class="review-avatar" src="<%=r.profilePicture%>"><%}else{%><div class="review-avatar review-avatar-fallback"><%=String(r.userName||'U').charAt(0).toUpperCase()%></div><%}%><div class="review-author"><strong><%=r.userName%></strong><div class="review-stars"><%= '★'.repeat(r.rating)%><%= '☆'.repeat(5-r.rating)%></div><small><%=r.courseTitle%></small></div><time><%=new Date(r.createdAt).toLocaleDateString()%></time></div><p><%=r.comment||'No written comment.'%></p><form action="/admin/reviews/delete" method="POST" onsubmit="return confirm('Delete this review?')"><input type="hidden" name="courseId" value="<%=r.courseId%>"><input type="hidden" name="reviewId" value="<%=r._id%>"><button class="btn btn-red btn-sm">Delete Review</button></form></article><%})%><%if(!reviews.length){%><div class="white-card empty-dashboard-card"><span>⭐</span><p>No reviews yet.</p></div><%}%></div></main></body></html>


